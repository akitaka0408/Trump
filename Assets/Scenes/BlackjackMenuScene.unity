    - target: {fileID: 7636605093601949696, guid: 58b5ab996cbbc2e4294e88d315e48b98, type: 3}
      propertyPath: m_text
      value: "\u30FB\u30D7\u30EC\u30A4\u30E4\u30FC\u64CD\u4F5C\r\n\u3000Hit \u2192
        1\u679A\u5F15\u304F\r\n\u3000Stand \u2192 \u5F15\u304B\u305A\u7D42\u4E86\r\n\u3000Double
        \u2192 \u30D9\u30C3\u30C82\u500D\uFF0B1\u679A\u5F15\u3044\u3066\u7D42\u4E86\r\n   
        (3\u679A\u76EE\u3092\u5F15\u304F\u3068\u304D\u306B\u4E8C\u500D\u306E\u30D9\u30C3\u30C8\u91CF\u3092\u6255\u3048\u308B\n\u3000\u5834\u5408\u306E\u307F\u4F7F\u7528\u53EF)\r\n\r\n\u30FB\u30AB\u30FC\u30C9\u306E\u70B9\u6570\r\n\u30002\u301C10
        \u2192 \u6570\u5B57\u901A\u308A\r\n\u3000J/Q/K \u2192 10\u70B9\r\n\u3000A
        \u2192 1\u70B9 or 11\u70B9\r\n\u3000(\u30DE\u30FC\u30AF\u306B\u3088\u308B\u5DEE\u306F\u306A\u3044)\r\n"
      objectReference: {fileID: 0}
