    - target: {fileID: 6447391840987171146, guid: 58b5ab996cbbc2e4294e88d315e48b98, type: 3}
      propertyPath: m_text
      value: "\u30FB\u5408\u8A08\u304C21\u3092\u8D85\u3048\u308B\u304B\u3001Double
        \u3092\u3057\u305F\u5834\u5408\u3001\n    \u81EA\u52D5\u3067\u30DB\u30B9\u30C8\u306E\u30BF\u30FC\u30F3\u306B\u306A\u308B\r\n\r\n\u30FB\u30B2\u30FC\u30E0\u958B\u59CB\u6642\u306B\u8CED\u3051\u91D1\u3092\u6C7A\u3081\u3001\u52DD\u6557\u306B\r\n\u3000\u5FDC\u3058\u3066\u5897\u6E1B\r\n\r\n\u30FB\u6700\u521D\u306E2\u679A\u304CA
        + 10\u70B9\u30AB\u30FC\u30C9\u3060\u3068\n    BlackJack\u3068\u3044\u3046\u7279\u6B8A\u52DD\u5229\u306B\u306A\u308B\n\n\u30FB\u30B2\u30FC\u30E0\u958B\u59CB\u6642\u306F\u624B\u672D\u304C2\u679A\n\n"
