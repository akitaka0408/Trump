    - target: {fileID: 5996531153722741517, guid: 58b5ab996cbbc2e4294e88d315e48b98, type: 3}
      propertyPath: m_text
      value: "\u30FB\u30DB\u30B9\u30C8(CPU)\u30681\u5BFE1\u3067\u52DD\u8CA0\n\n\u30FB\u30AB\u30FC\u30C9\u3092\u5F15\u304D\u624B\u672D\u306E\u5408\u8A08\u70B9\u6570\u304C21\u3092\n   
        \u8D85\u3048\u306A\u3044\u3088\u3046\u306B21\u306B\u8FD1\u3065\u3051\u308B\u30B2\u30FC\u30E0\n\u3000\n\u30FB\u5408\u8A08\u304C21\u3092\u8D85\u3048\u305F\u3089\u6570\u5024\u304C\u30DB\u30B9\u30C8\n\u3000\u3088\u308A21\u306B\u8FD1\u304F\u3066\u3082\u6557\u5317\n\n\u30FB\u5408\u8A08\u304C\u30DB\u30B9\u30C8\u3068\u540C\u3058\u304B\u3001\u304A\u4E92\u3044\u306B\n\u300021\u3092\u8D85\u3048\u305F\u5834\u5408\u306F\u5F15\u304D\u5206\u3051\u306B\u306A\u308B\n\n\u30FB\u5408\u8A08\u304C\u304A\u4E92\u3044\u306B21\u3067\u3001\u7247\u65B9\u3060\u3051\n    
        BlackJack\u306E\u5834\u5408\u305D\u3061\u3089\u304C\u52DD\u5229\u3059\u308B\n\n\n\n\n\r\n"
      objectReference: {fileID: 0}
